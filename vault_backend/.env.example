# ============================================================
# Django Settings Configuration
# ============================================================
# Generated with: python -c "import secrets; print(secrets.token_hex(64))"
# Must be at least 50 characters of random hex data.
SECRET_KEY=your-super-secret-random-master-signing-key

# Set to True only for local development. NEVER set to True in production.
DEBUG=False

# Comma-separated list of allowed host domains.
# Example: api.yourvaultdomain.com,127.0.0.1,localhost
ALLOWED_HOSTS=api.yourvaultdomain.com,127.0.0.1,localhost

# Optional. Enables server-side vault key escrow so an OTP-only password reset (no old
# password, no Recovery Key) can still recover the vault. Leaving this blank disables the
# feature entirely -- OTP-only resets then permanently lose the vault, preserving full
# zero-knowledge encryption. Setting it means the server (and anyone who compromises it)
# can decrypt any admin's vault key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ESCROW_KEY=

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
DB_NAME=vault_db
DB_USER=vault_user
DB_PASSWORD=your-strong-random-db-password
DB_HOST=localhost  # Use 'localhost' for local direct execution, or 'db' inside Docker Compose
DB_PORT=5432

# ============================================================
# CORS Configurations
# ============================================================
# Frontend origins allowed to make API requests.
# Vite React Server default is http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourvaultdomain.com

# ============================================================
# Email Configurations (SMTP)
# ============================================================
# Development host user is optional; if blank, it falls back to console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Secure Vault <no-reply@yourvaultdomain.com>

# ============================================================
# Celery & Redis Task Queue Configuration
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# Local-dev only. Leave False (or unset) in every deployed environment -- LocMemCache is
# per-process, so rate-limiting stops being enforced consistently across workers. Only set
# to True on a machine that doesn't have Redis installed, just to unblock local testing.
USE_LOCAL_CACHE=False

# ============================================================
# Observability & Error Tracking (Sentry APM)
# ============================================================
# Leave blank for local offline development.
SENTRY_DSN=https://your-sentry-key@o0.ingest.sentry.io/0
