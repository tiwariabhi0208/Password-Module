# ============================================================
# Django Settings Configuration
# ============================================================
# Generated with: python -c "import secrets; print(secrets.token_hex(64))"
# Must be at least 50 characters of random hex data.
SECRET_KEY=your-super-secret-random-master-signing-key

# Set to True only for local development. NEVER set to True in production.
DEBUG=False

# Comma-separated list of allowed host domains.
# Example: api.yourvaultdomain.com,127.0.0.1,localhost
ALLOWED_HOSTS=api.yourvaultdomain.com,127.0.0.1,localhost

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
DB_NAME=vault_db
DB_USER=vault_user
DB_PASSWORD=your-strong-random-db-password
DB_HOST=localhost
DB_PORT=5432

# ============================================================
# CORS Configurations
# ============================================================
# Frontend origins allowed to make API requests.
# Vite React Server default is http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourvaultdomain.com

# ============================================================
# Email Configurations (SMTP)
# ============================================================
# Development host user is optional; if blank, it falls back to console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Secure Vault <no-reply@yourvaultdomain.com>

# ============================================================
# Celery & Redis Task Queue Configuration
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
